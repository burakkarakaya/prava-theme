{% liquid
  assign p = product
  assign current_variant = null
  assign main_img = null
  if p != blank
    assign current_variant = p.selected_or_first_available_variant
    assign main_img = current_variant.featured_image | default: p.featured_image
  endif

  assign uid = title_id | strip
  if uid == blank and p != blank
    assign uid = 'product-list-' | append: p.id
  endif
  if uid == blank
    assign uid = 'product-list-card'
  endif

  assign img_loading = image_loading | default: 'lazy'

  assign color_option = null
  if p != blank
    for option in p.options_with_values
      assign opt_name = option.name | downcase
      if opt_name contains 'color' or opt_name contains 'colour' or opt_name contains 'renk'
        assign color_option = option
        break
      endif
    endfor
  endif

  assign hover_vid = hover_video_url | strip
  assign has_hover_video = false
  if hover_vid != blank
    assign has_hover_video = true
  endif

  assign effective_hover_image = hover_image
  if effective_hover_image == blank and p != blank and p.images.size > 1
    assign effective_hover_image = p.images[1]
    if main_img != blank and effective_hover_image.id == main_img.id
      if p.images.size > 2
        assign effective_hover_image = p.images[2]
      else
        assign effective_hover_image = blank
      endif
    endif
  endif

  assign has_hover_image = false
  if effective_hover_image != blank and has_hover_video == false
    assign has_hover_image = true
  endif

  assign use_group = false
  if has_hover_video or has_hover_image
    assign use_group = true
  endif
%}
{% if p != blank %}
  <article
    class="prava-bestsellers-card flex h-full flex-col bg-product-color{% if use_group %} group{% endif %}"
    {% if block %}
      {{- block.shopify_attributes -}}
    {% endif %}
  >
    <a
      href="{{ p.url }}"
      class="flex h-full flex-col text-left text-inherit no-underline outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
      aria-labelledby="{{ uid }}"
    >
      <div class="prava-swiper-card__media relative flex aspect-[1/1] w-full items-center justify-center overflow-hidden">
        {% if main_img != blank %}
          <img
            src="{{ main_img | image_url: width: 1040 }}"
            alt="{{ main_img.alt | default: p.title | escape }}"
            class="relative z-0 block h-full w-full object-contain{% if use_group %} transition-opacity duration-500 ease-out group-hover:opacity-0{% endif %}"
            width="{{ main_img.width | default: 520 }}"
            height="{{ main_img.height | default: 640 }}"
            loading="{{ img_loading }}"
            decoding="async"
          >
        {% endif %}
        {% if has_hover_image %}
          <img
            src="{{ effective_hover_image | image_url: width: 1040 }}"
            alt=""
            class="pointer-events-none absolute inset-0 z-[1] h-full w-full object-cover object-bottom opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
            width="{{ effective_hover_image.width | default: 520 }}"
            height="{{ effective_hover_image.height | default: 640 }}"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          >
        {% endif %}
        {% if has_hover_video %}
          <video
            class="pointer-events-none absolute inset-0 z-[1] h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
            playsinline
            muted
            loop
            preload="none"
            data-bestseller-hover-video
            aria-hidden="true"
            tabindex="-1"
          >
            <source src="{{ hover_vid | escape }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
      <div class="flex flex-1 flex-col px-5 py-5 lg:p-5">
        <h3 id="{{ uid }}" class="text-lg font-medium !leading-tight tracking-tight text-neutral-900 md:text-lg">
          {{ p.title }}
        </h3>
        {% if p.type != blank %}
          <p class="mt-2 mb-4 text-xs font-light uppercase tracking-wide text-neutral-500 md:text-sm">{{ p.type }}</p>
        {% endif %}
        <div class="mt-auto flex items-center justify-between gap-4">
          {% if color_option != blank and color_option.values.size > 0 %}
            <ul
              class="m-0 flex list-none flex-wrap items-center gap-2 p-0"
              role="list"
              aria-label="{{ 'general.accessibility.color_options' | t }}"
            >
              {% for value in color_option.values %}
                <li class="m-0 p-0">
                  {% liquid
                    assign i = forloop.index0 | modulo: 4
                    case i
                      when 0
                        assign swatch_bg = 'bg-[#bf7f83]'
                      when 1
                        assign swatch_bg = 'bg-[#d4c176]'
                      when 2
                        assign swatch_bg = 'bg-[#9ea78a]'
                      else
                        assign swatch_bg = 'bg-[#88acc8]'
                    endcase
                  %}
                  <span
                    class="inline-block h-5 w-5 shrink-0 rounded-full {{ swatch_bg }} ring-1 ring-black/5"
                    title="{{ value | escape }}"
                    aria-hidden="true"
                  ></span>
                  <span class="sr-only">{{ value }}</span>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <span class="min-w-0 flex-1" aria-hidden="true"></span>
          {% endif %}
          <p class="shrink-0 text-right text-base leading-none md:text-lg">
            {% render 'price-with-compare', variant: current_variant, style: 'card' %}
          </p>
        </div>
      </div>
    </a>
  </article>
{% elsif request.design_mode and block %}
  <article
    class="prava-bestsellers-card flex min-h-[240px] flex-col items-center justify-center border-2 border-dashed border-neutral-300 bg-neutral-50"
    {{ block.shopify_attributes }}
  >
    <p class="m-0 px-4 text-center text-sm text-neutral-500">Ürün seçin</p>
  </article>
{% endif %}
