{% comment %}
  pdp-collection-recommendations
  Ürünün ilk koleksiyonundan, kendisi hariç öneri ürünleri listeler.
  Kart: snippets/product-list-card.liquid (liste / koleksiyon ile aynı).
{% endcomment %}

{% assign current_collection = product.collections.first %}
{% assign rec_limit = limit | default: 8 %}
{% assign shown = 0 %}
{% assign available_count = 0 %}

{% if current_collection %}
  {% for rec in current_collection.products %}
    {% if rec.id != product.id %}
      {% assign available_count = available_count | plus: 1 %}
      {% if available_count >= rec_limit %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if available_count > 0 %}
    <div class="container mt-24 mx-auto px-5 lg:px-0">
      <h2 class="text-3xl font-medium tracking-tight text-neutral-900 md:text-4xl">
        {{ 'sections.product_detail.related_products_title' | t }}
      </h2>

      <ul class="mt-10 grid grid-cols-1 gap-5 sm:gap-x-6 sm:gap-y-6 md:grid-cols-3 lg:grid-cols-4" aria-label="{{ current_collection.title | escape }} ürünleri">
        {% for rec in current_collection.products %}
          {% if rec.id != product.id and shown < rec_limit %}
            <li class="h-full">
              {% render 'product-list-card',
                product: rec,
                title_id: 'related-' | append: rec.id,
                image_loading: 'lazy'
              %}
            </li>
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}
{% endif %}
