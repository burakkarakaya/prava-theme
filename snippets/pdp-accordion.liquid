{% capture dimensions_item %}
  {% render 'pdp-dimensions', product: product %}
{% endcapture %}
{% capture features_item %}
  {% render 'pdp-features', product: product %}
{% endcapture %}
{% capture usage_item %}
  {% render 'pdp-usage', product: product %}
{% endcapture %}

{% if dimensions_item != blank or features_item != blank or usage_item != blank %}
  <div class="contioner lg:px-[100px] px-5">
    <div class="lg:border max-w-[1400px] mx-auto mt-16 lg:rounded-xl border border-neutral-200/80 bg-product-bg px-5 py-6 shadow-[0_12px_40px_rgba(25,25,25,0.08)] md:px-10 md:py-4">
      <div class="divide-y divide-neutral-300/80">
      {{ dimensions_item }}
      {{ features_item }}
      {{ usage_item }}
      </div>
    </div>
  </div>
{% endif %}

