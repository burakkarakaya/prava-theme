{% liquid
  assign main_menu = linklists['main-menu']
  assign nav_items = shop.metaobjects.navigation_item.values
  assign header_transparent = false
  assign has_list_cover_image = false
  assign header_is_transparent = false
  if template.name == 'index'
    assign header_transparent = true
  endif
  if template.name == 'collection' and collection and collection.metafields.custom.cover_image.value != blank
    assign has_list_cover_image = true
  endif
  if header_transparent or has_list_cover_image
    assign header_is_transparent = true
  endif
%}
{% if header_is_transparent %}
  <div id="site-header-gradient" class="pointer-events-none fixed inset-x-0 top-0 z-[60] h-[120px] bg-gradient-to-b from-black/45 to-transparent" aria-hidden="true"></div>
{% endif %}

  <header
    id="site-header"
    class="prava-site-header z-[100] flex h-[64px] lg:h-[88px] shrink-0 items-center justify-between px-4 lg:px-10 transition-[background-color,box-shadow] duration-200{% if header_is_transparent %} fixed left-0 right-0 top-0 bg-transparent{% else %} sticky top-0 w-full bg-custom-color{% endif %}{% if has_list_cover_image %} list-cover-image{% endif %}"
    style="--header-pad-x: 40px;"
    role="banner"
    data-header-theme="{% if header_is_transparent %}transparent{% else %}solid{% endif %}"
  >
    <button
      type="button"
      id="btn-menu"
      class="flex items-center gap-3 text-base font-semibold tracking-wide transition-opacity hover:opacity-80{% if header_is_transparent %} text-white{% else %} text-neutral-900{% endif %}"
      aria-expanded="false"
      aria-controls="mega-menu"
      aria-haspopup="dialog"
      aria-label="{{ 'header.menu_open' | t }}"
    >
      <img
        src="{{ 'icons/menu.svg' | asset_url }}"
        width="32"
        height="32"
        alt=""
        class="shrink-0{% unless header_is_transparent %} brightness-0{% endunless %}"
        aria-hidden="true"
      >
      <span class="hidden lg:block" aria-hidden="true">{{ 'header.menu_visible' | t }}</span>
    </button>
    <a href="{{ routes.root_url }}" class="absolute left-40 lg:left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-label="{{ 'header.home' | t: shop_name: shop.name }}">
      <img
        src="{{ 'icons/prava_logo.svg' | asset_url }}"
        width="120"
        height="22"
        alt="{{ shop.name | escape }}"
        class="h-[22px] w-auto{% unless header_is_transparent %} brightness-0{% endunless %}"
      >
    </a>
    <nav class="flex items-center gap-1 text-[15px] font-semibold tracking-wide lg:gap-10{% if header_is_transparent %} text-white{% else %} text-neutral-900{% endif %}" aria-label="{{ 'header.utility_nav' | t }}">
      <button
        type="button"
        id="mini-search-open"
        class="inline-flex items-center gap-2 py-1 font-light transition-opacity hover:opacity-80{% if header_is_transparent %} lg:border-b border-white/40 text-white{% else %} border-b border-neutral-300 text-neutral-900{% endif %}"
        aria-expanded="false"
        aria-controls="mini-search-dialog"
        aria-haspopup="dialog"
        aria-label="{{ 'header.search' | t }}"
      >
        <img
          src="{{ 'icons/search.svg' | asset_url }}"
          width="20"
          height="19"
          alt=""
          class="h-[19px] w-5 shrink-0 lg:h-[17px] lg:w-[18px]{% unless header_is_transparent %} brightness-0{% endunless %}"
          aria-hidden="true"
        >
        <span class="hidden lg:block">{{ 'header.search' | t }}</span>
      </button>
      {% comment %}
        New Customer Accounts: Shopify <shopify-account>. Liquid: {% if customer %}; JS: document.documentElement.dataset.customerSignedIn
      
      {% if shop.customer_accounts_enabled %}
        <div class="header-nav-account hidden items-center justify-center md:flex" title="{{ 'header.account' | t }}">
          <shopify-account menu="customer-account-main-menu"></shopify-account>
        </div>
      {% endcomment %}
      {% if shop.customer_accounts_enabled %}
        <div class="header-nav-account flex items-center justify-center">
          <shopify-account menu="customer-account-main-menu">
            <div
              slot="signed-out-avatar"
              class="inline-flex items-center gap-2 py-1 text-[15px] font-light tracking-wide transition-opacity hover:opacity-80{% if header_is_transparent %} border-white/40 text-white{% else %} border-neutral-300 text-neutral-900{% endif %}"
            >
              <img
                src="{{ 'icons/account.svg' | asset_url }}"
                width="32"
                height="32"
                alt=""
                class="h-8 w-8 shrink-0 lg:hidden{% unless header_is_transparent %} brightness-0{% endunless %}"
                aria-hidden="true"
                data-test-id="header_account"
              >
              <span class="hidden lg:block">{{ 'header.account' | t }}</span>
            </div>
          </shopify-account>
        </div>
      {% endif %}
      <a
        href="{{ routes.cart_url }}"
        id="cart-icon-bubble"
        class="flex items-center gap-2 font-light transition-opacity hover:opacity-80{% if header_is_transparent %} text-white{% else %} text-neutral-900{% endif %}"
        aria-label="{{ 'header.cart' | t }}"
      >
        {% render 'prava-cart-icon-inner', transparent_header: header_is_transparent %}
      </a>
    </nav>
  </header>

  {% render 'mini-search' %}

  <div id="mega-menu" class="mega-menu" role="dialog" aria-modal="true" aria-label="{{ 'header.mega_menu_label' | t }}" hidden>
    <div class="mega-menu__inner" style="--mega-pad-x: 40px;">
      <div class="mega-menu__bar">
        <button type="button" class="mega-menu__close pl-2" id="mega-menu-close" aria-label="{{ 'header.mega_menu_close' | t }}">
          <svg class="mega-menu__close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
          <span class="hidden lg:block text-base font-semibold" aria-hidden="true">{{ 'header.close_visible' | t }}</span>
        </button>
        <div class="mega-menu__logo" id="mega-menu-logo">
          <img src="{{ 'icons/prava_logo.svg' | asset_url }}" width="120" height="22" alt="{{ shop.name | escape }}" class="h-[22px] w-auto invert lg:hidden">
        </div>
      </div>
      {% comment %} main-menu (Gezinme) + navigation_item metaobject — snippets/mega-menu-dynamic.liquid {% endcomment %}
      {% render 'mega-menu-dynamic', main_menu: main_menu, nav_items: nav_items %}
      {% if main_menu.links.size > 0 %}
        <div class="mega-menu__footer">
          <a href="{{ main_menu.links.first.url }}" class="mega-menu__footer-link" id="mega-footer-discover">{{ main_menu.links.first.title | escape }}</a>
          <a href="#" class="mega-menu__footer-cta" id="mega-footer-cta">{{ 'header.mega_default_cta' | t }}</a>
        </div>
      {% endif %}
    </div>
    <button
      type="button"
      class="mega-menu__backdrop w-full h-full absolute top-0 left-0"
      id="mega-menu-backdrop"
      aria-label="{{ 'header.mega_menu_close' | t }}"
      tabindex="-1"
    ></button>
  </div>
