{% liquid
  assign coll = collection
  assign display_title = block.settings.custom_title | strip
  if display_title == blank and coll != blank
    assign display_title = coll.title
  endif

  assign card_image = block.settings.custom_image
  if card_image == blank and coll != blank
    assign card_image = coll.featured_image
  endif

  assign link_url = '#'
  if coll != blank
    assign link_url = coll.url
  endif
  assign title_id = 'category-rail-title-' | append: block.id
  assign cta_text = block.settings.cta_label | strip
  if cta_text == blank
    assign cta_text = 'sections.category_rail.cta' | t
  endif

  assign is_placeholder = false
  if coll == blank and request.design_mode
    assign is_placeholder = true
    assign display_title = 'sections.category_rail.placeholder_title' | t
  endif
%}
{% if coll != blank or is_placeholder %}
  <div class="swiper-slide !h-auto" {{ block.shopify_attributes }}>
    <article class="prava-category-card flex h-full flex-col">
      {% unless is_placeholder %}
        <a
          href="{{ link_url }}"
          class="flex h-full flex-col text-left text-inherit no-underline outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
          aria-label="{{ 'sections.category_rail.cta_named' | t: title: display_title }}"
        >
      {% endunless %}
        <div class="prava-category-card__media prava-swiper-card__media aspect-square w-full overflow-hidden bg-product-color flex items-center justify-center">
          {% if card_image != blank %}
            <img
              src="{{ card_image | image_url: width: 1040 }}"
              width="520"
              height="520"
              alt="{{ display_title | escape }}"
              class="prava-category-card__img"
              loading="{{ loading }}"
              {% if display_title != blank %}aria-labelledby="{{ title_id }}"{% endif %}
            >
          {% elsif is_placeholder %}
            <span class="px-4 text-center text-sm text-neutral-500">{{ 'sections.category_rail.placeholder_title' | t }}</span>
          {% endif %}
        </div>
        <h3 id="{{ title_id }}" class="mt-4 lg:mt-6 text-left text-xl lg:text-[26px] font-normal leading-snug tracking-tight text-neutral-900 lg:text-3xl">
          {{ display_title }}
        </h3>
        {% unless is_placeholder %}
          <span class="mt-2 inline-block w-max text-sm font-light text-neutral-900 underline decoration-neutral-900 underline-offset-[5px]">
            {{ cta_text }}
          </span>
        {% endunless %}
      {% unless is_placeholder %}
        </a>
      {% endunless %}
    </article>
  </div>
{% endif %}
