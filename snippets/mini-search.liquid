{% comment %}
  Header mini arama — Predictive Search API + debounce (assets/js/main.js).
  Sepet çekmecesiyle aynı: sağdan panel, overlay, transition-transform.
{% endcomment %}
<div
  id="mini-search"
  class="mini-search pointer-events-none fixed inset-0 z-[225]"
  aria-hidden="true"
  data-mini-search-root
>
  <div
    class="mini-search__backdrop fixed inset-0 z-0 bg-white/40 transition-opacity duration-300"
    data-mini-search-close
    aria-hidden="true"
  ></div>
  <div
    id="mini-search-dialog"
    class="mini-search__panel fixed right-0 top-0 z-[1] flex h-full w-full max-w-md flex-col bg-white text-neutral-900 transition-transform duration-300 ease-out"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'header.mini_search_title' | t }}"
    tabindex="-1"
  >
    <div class="flex shrink-0 items-center justify-between border-b border-neutral-200/90 px-6 py-4">
      <h2 class="m-0 text-lg font-semibold tracking-tight text-neutral-900 md:text-xl">
        {{ 'header.mini_search_title' | t }}
      </h2>
      <button
        type="button"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md text-2xl leading-none text-neutral-600 transition-colors hover:bg-neutral-200/80 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-800"
        data-mini-search-close
        aria-label="{{ 'header.mini_search_close' | t }}"
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <form
      class="mini-search__form shrink-0 border-b border-neutral-200/80"
      id="mini-search-form"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
    >
      <label class="sr-only" for="mini-search-input">{{ 'header.mini_search_label' | t }}</label>
      <div class="mini-search__field flex items-center gap-3 px-6 py-3">
        <img
          src="{{ 'icons/search.svg' | asset_url }}"
          width="18"
          height="17"
          alt=""
          class="mini-search__field-icon h-[17px] w-[18px] shrink-0 opacity-50 brightness-0"
          aria-hidden="true"
        >
        <input
          id="mini-search-input"
          class="mini-search__input min-w-0 flex-1 border-0 bg-transparent py-2 text-base text-neutral-900 outline-none placeholder:text-neutral-500"
          type="text"
          name="q"
          inputmode="search"
          enterkeyhint="search"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          placeholder="{{ 'header.mini_search_placeholder' | t }}"
        >
        <button
          type="button"
          id="mini-search-clear-input"
          class="mini-search__clear-input shrink-0"
          hidden
          aria-label="{{ 'header.mini_search_clear' | t }}"
        >
          {{ 'header.mini_search_clear' | t }}
        </button>
      </div>
    </form>
    <div
      id="mini-search-results"
      class="mini-search__results min-h-0 flex-1 overflow-y-auto overscroll-contain"
      role="region"
      aria-live="polite"
      aria-label="{{ 'header.mini_search_results' | t }}"
    ></div>
    <div class="mini-search__footer shrink-0 border-t border-neutral-200/90 bg-[#eeedeb] px-6 py-4 text-center">
      <a href="{{ routes.search_url }}" id="mini-search-view-all" class="mini-search__view-all" hidden>
        {{ 'header.mini_search_view_all' | t }}
      </a>
    </div>
  </div>
</div>
