{% comment %}
  Mega menü — main-menu + navigation_item metaobject (menu_uri ↔ link.url).

  Metaobject: navigation_item — örnek alanlar:
  menu_uri, gorsel, icon_name, aciklama, discover_label, discover_url, cta_label, cta_url

  Sağ sütun: kategori hover’ında görsel değişir (data-gorsel). Görsel yoksa Unsplash placeholder.

  Parametreler: main_menu, nav_items
{% endcomment %}
{% assign mega_cta_default = 'header.mega_default_cta' | t %}
{% assign mega_menu_visual_video = 'https://assets.mixkit.co/videos/14471/14471-720.mp4' %}
{% assign mega_menu_visual_video_poster = 'https://assets.mixkit.co/videos/14471/14471-thumb-720-0.jpg' %}
{% assign mega_placeholder_imgs = 'https://images.unsplash.com/photo-1483985988355-763728c55c27?w=1040&q=80,https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?w=1040&q=80,https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1040&q=80,https://images.unsplash.com/photo-1515886657613-9f3525f0ccfe?w=1040&q=80,https://images.unsplash.com/photo-1529139574466-a303027c1d8b?w=1040&q=80,https://images.unsplash.com/photo-1539109136882-3a94eabd4396?w=1040&q=80' | split: ',' %}
{% assign mega_ph_count = mega_placeholder_imgs.size %}

{% if main_menu.links.size > 0 %}
  <div class="mega-menu__tabs-wrap">
    <div class="mega-menu__tabs" role="tablist" aria-label="{{ 'header.mega_menu_tabs' | t }}">
      {% for link in main_menu.links %}
        {% assign pmeta = false %}
        {% for entry in nav_items %}
          {% if entry.menu_uri.value == link.url %}
            {% assign pmeta = entry %}
            {% break %}
          {% endif %}
        {% endfor %}
        <button
          type="button"
          class="mega-menu__tab{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="mega-panel-{{ forloop.index0 }}"
          data-mega-tab="{{ forloop.index0 }}"
          id="mega-tab-{{ forloop.index0 }}"
        >
          {{ link.title | escape }}
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="mega-menu__panels">
    {% for link in main_menu.links %}
      {% assign pmeta = false %}
      {% for entry in nav_items %}
        {% if entry.menu_uri.value == link.url %}
          {% assign pmeta = entry %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% liquid
        assign panel_index = forloop.index0
        assign panel_ph_index = panel_index | modulo: mega_ph_count
        assign panel_placeholder = mega_placeholder_imgs[panel_ph_index]

        if pmeta
          assign fd = pmeta.discover_label.value | default: link.title
          assign fh = pmeta.discover_url.value | default: link.url
          assign fc = pmeta.cta_label.value | default: mega_cta_default
          assign fch = pmeta.cta_url.value | default: '#'
        else
          assign fd = link.title
          assign fh = link.url
          assign fc = mega_cta_default
          assign fch = '#'
        endif

        assign panel_default_src = panel_placeholder
        if pmeta and pmeta.gorsel.value != blank
          assign panel_default_src = pmeta.gorsel.value | image_url: width: 1040
        elsif settings.mega_menu_featured_image != blank
          assign panel_default_src = settings.mega_menu_featured_image | image_url: width: 1040
        endif

        assign panel_visual_src = panel_default_src
        assign panel_visual_alt = link.title
        assign panel_use_video = false
        if panel_ph_index == 1
          unless pmeta and pmeta.gorsel.value != blank
            unless settings.mega_menu_featured_image != blank
              assign panel_use_video = true
              assign panel_default_src = mega_menu_visual_video_poster
              assign panel_visual_src = mega_menu_visual_video_poster
            endunless
          endunless
        endif
      %}

      <div
        class="mega-menu__panel"
        role="tabpanel"
        id="mega-panel-{{ panel_index }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
        aria-labelledby="mega-tab-{{ panel_index }}"
        data-mega-panel="{{ panel_index }}"
        data-footer-discover="{{ fd | escape }}"
        data-footer-discover-href="{{ fh | escape }}"
        data-footer-cta="{{ fc | escape }}"
        data-footer-cta-href="{{ fch | escape }}"
      >
        <div class="mega-menu__panel-grid">
          <div class="mega-menu__col mega-menu__col--list">
            {% if link.links.size > 0 %}
              <ul class="mega-menu__sublist">
                {% for child in link.links %}
                  {% assign child_meta = false %}
                  {% for entry in nav_items %}
                    {% if entry.menu_uri.value == child.url %}
                      {% assign child_meta = entry %}
                      {% break %}
                    {% endif %}
                  {% endfor %}

                  {% liquid
                    assign child_ph_index = forloop.index0 | modulo: mega_ph_count
                    assign child_gorsel = mega_placeholder_imgs[child_ph_index]
                    if child_meta and child_meta.gorsel.value != blank
                      assign child_gorsel = child_meta.gorsel.value | image_url: width: 1040
                    endif
                    if child.active or forloop.first
                      unless panel_use_video
                        assign panel_visual_src = child_gorsel
                        assign panel_visual_alt = child.title
                      endunless
                    endif
                  %}

                  <li data-gorsel="{{ child_gorsel | escape }}">
                    <a
                      href="{{ child.url }}"
                      class="mega-menu__subitem{% if forloop.first or child.active %} is-active{% endif %}"
                      {% if child.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {% if child_meta and child_meta.icon_name.value != blank %}
                        <span class="mega-menu__subicon" aria-hidden="true">
                          <img
                            src="{{ child_meta.icon_name.value | strip | asset_url }}"
                            alt=""
                            width="48"
                            height="48"
                            loading="lazy"
                            class="h-[32px] w-auto"
                          >
                        </span>
                      {% endif %}
                      <span class="mega-menu__subtext">
                        <span class="mega-menu__subtitle">{{ child.title | escape }}</span>
                        {% if child_meta and child_meta.aciklama.value != blank %}
                          <span class="mega-menu__subdesc hidden lg:block">{{ child_meta.aciklama.value }}</span>
                        {% endif %}
                      </span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <ul class="mega-menu__sublist">
                <li data-gorsel="{{ panel_default_src | escape }}">
                  <a href="{{ link.url }}" class="mega-menu__subitem is-active">
                    <span class="mega-menu__subtext">
                      <span class="mega-menu__subtitle">{{ link.title | escape }}</span>
                      {% if pmeta and pmeta.aciklama.value != blank %}
                        <span class="mega-menu__subdesc">{{ pmeta.aciklama.value }}</span>
                      {% endif %}
                    </span>
                  </a>
                </li>
              </ul>
            {% endif %}
          </div>
          <div class="mega-menu__col mega-menu__col--visual hidden lg:block">
            <div
              class="mega-menu__visual"
              data-default-src="{{ panel_default_src | escape }}"
              {% if panel_use_video %}
                data-default-video="{{ mega_menu_visual_video | escape }}"
              {% endif %}
            >
              {% if panel_use_video %}
                <video
                  class="mega-menu__visual-video"
                  data-mega-visual-video
                  src="{{ mega_menu_visual_video | escape }}"
                  poster="{{ mega_menu_visual_video_poster | escape }}"
                  width="520"
                  height="640"
                  muted
                  loop
                  playsinline
                  autoplay
                  aria-hidden="true"
                ></video>
              {% endif %}
              <img
                src="{{ panel_visual_src | escape }}"
                width="520"
                height="640"
                alt="{{ panel_visual_alt | escape }}"
                class="mega-menu__visual-img{% if panel_use_video %} mega-menu__visual-img--hidden{% endif %}"
                data-mega-visual-img
                loading="lazy"
                decoding="async"
              >
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}
