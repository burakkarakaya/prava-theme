<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-customer-signed-in="{% if customer %}true{% else %}false{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical_url }}">

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% elsif shop.description != blank %}
    <meta name="description" content="{{ shop.description | strip_html | strip | truncate: 160 | escape }}">
  {% endif %}

  {% render 'seo-meta' %}
  {% render 'seo-schema-org' %}
  {% if template.name == 'product' %}
    {% render 'product-json-ld', product: product %}
  {% endif %}
  {{ content_for_header }}

  {% comment %}
    Sepete ekle (AJAX): assets/product-detail.js ve benzeri formlar routes.cart_add_url ile fetch yapar (Dawn ile aynı desen).
  {% endcomment %}
  <script>
    window.routes = {
      cart_add_url: {{ routes.cart_add_url | json }},
      cart_url: {{ routes.cart_url | json }},
      search_url: {{ routes.search_url | json }},
      predictive_search_url: {{ routes.predictive_search_url | json }}
    };
    window.PRAVA_I18N = window.PRAVA_I18N || {};
    window.PRAVA_I18N.cart_add_error = {{ 'products.cart_add_error' | t | json }};
    window.PRAVA_I18N.cart_add_network = {{ 'products.cart_add_network' | t | json }};
    window.PravaCartSections = 'prava-cart-drawer,prava-cart-bubble';
  </script>
  {% if template.name == 'collection' %}
    <script>
      (function () {
        try {
          if (localStorage.getItem('prava-collection-grid-cols') === '4') {
            document.documentElement.classList.add('prava-collection-grid-4');
          }
        } catch (e) {}
      })();
    </script>
  {% endif %}

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  {{ 'css/style.css' | asset_url | stylesheet_tag }}
  {{ 'prava-cart-drawer.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'prava-cart-drawer.js' | asset_url }}" defer="defer"></script>

  {% comment %}
    Tailwind Play CDN: senkron <script src> ile yüklenmeli.
    createElement/appendChild ile gecikmeli yükleme ilk boyamada FOUC ve düzen sıçramasına yol açıyor.
    config, CDN yüklendikten hemen sonra ayrı blokta çalışır.
  {% endcomment %}
  <link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Sen', 'system-ui', 'sans-serif'] },
          colors: {
            'custom-color': '#f5f5f3',
            'product-color': '#fff',
          },
        },
      },
    };
  </script>
  {% if template.name == 'index' and settings.preloader_enable != false %}
    <script>
      (function () {
        var KEY = 'prava-preloader-seen';
        function isReload() {
          var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
          if (nav) return nav.type === 'reload';
          return !!(performance.navigation && performance.navigation.type === 1);
        }
        var seen = false;
        try {
          seen = sessionStorage.getItem(KEY) === '1';
        } catch (e) {}
        if (seen && !isReload()) {
          window.__PRAVA_SKIP_PRELOADER = true;
          document.documentElement.classList.add('prava-preloader-skip');
        } else {
          document.documentElement.classList.add('prava-preloader-pending');
        }
      })();
    </script>
  {% endif %}
</head>
<body class="bg-custom-color antialiased text-[14px] text-white min-h-screen flex flex-col">
  <a class="skip-to-content-link sr-only focus:not-sr-only focus:absolute focus:z-[200] focus:m-4 focus:bg-white focus:p-3 focus:text-black focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-neutral-900" href="#MainContent">
    {{ 'general.accessibility.skip_to_content' | t }}
  </a>

  {% render 'site-preloader' %}
  {% render 'site-header' %}
  {% section 'prava-cart-drawer' %}

  <main id="MainContent" class="flex-1 w-full" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <button
    type="button"
    id="scroll-top-btn"
    class="hidden lg:flex"
    aria-label="Sayfa basina don"
  >
    <span aria-hidden="true">↑</span>
  </button>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  <script src="https://cdn.cloudimage.io/360-view/4.10.0/360-view.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/ScrollTrigger.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/SplitText.min.js" defer></script>
  <script src="https://unpkg.com/lenis@1.1.16/dist/lenis.min.js" defer></script>
  <script defer>
    window.PRAVA_I18N = window.PRAVA_I18N || {};
    window.PRAVA_I18N.slide_aria = {{ 'general.pagination.slide' | t | default: 'Slayt' | json }};
    window.PRAVA_I18N.mini_search_no_results = {{ 'header.mini_search_no_results' | t | json }};
    window.PRAVA_I18N.mini_search_error = {{ 'header.mini_search_error' | t | json }};
  </script>
  {% if template.name == 'index' and settings.preloader_enable != false %}
    <script src="{{ 'js/page-preloader.js' | asset_url }}" defer></script>
  {% endif %}
  <script src="{{ 'js/main.js' | asset_url }}" defer></script>
  <script src="{{ 'js/intro-karaoke.js' | asset_url }}" defer></script>
  <script src="{{ 'landing-history.js' | asset_url }}" defer></script>
</body>
</html>
