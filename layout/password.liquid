<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'css/style.css' | asset_url | stylesheet_tag }}
  <script src="https://unpkg.com/lenis@1.1.16/dist/lenis.min.js" defer></script>
</head>
<body class="relative bg-black font-sans text-white min-h-screen flex items-center justify-center p-6">
  <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:rounded focus:bg-white focus:px-4 focus:py-3 focus:text-black focus:outline focus:outline-2 focus:outline-offset-2" href="#PasswordContent">
    {{ 'general.accessibility.skip_to_content' | t }}
  </a>
  <main id="PasswordContent" class="w-full max-w-md" tabindex="-1">
    {{ content_for_layout }}
  </main>
  <script defer>
    (function () {
      if (typeof Lenis === 'undefined') return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var lenis = new Lenis({
        duration: 0.65,
        smoothWheel: true,
        wheelMultiplier: 1.15,
        touchMultiplier: 1.1,
        easing: function (t) {
          return 1 - Math.pow(1 - t, 3);
        },
      });

      function raf(time) {
        lenis.raf(time);
        window.requestAnimationFrame(raf);
      }
      window.requestAnimationFrame(raf);
    })();
  </script>
</body>
</html>
