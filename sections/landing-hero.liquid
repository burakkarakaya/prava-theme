{% comment %}
  Mağaza panelinde yok — yalnızca tema kodundan ayarlanır:
  hero_lazy_after_first: 2+ slaytta görsel/video lazy
  hero_media_aspect_ratio_class: örn. aspect-video
  hero_media_layer_extra_class: tüm slaytlarda .hero-parallax-layer üzerine ek class
{% endcomment %}
{% liquid
  assign hero_lazy_after_first = true
  assign hero_media_aspect_ratio_class = ''
  assign hero_media_layer_extra_class = ''

  assign show_nav = true
  assign show_pag = true

  if section.blocks.size < 2
    assign show_pag = false
    assign show_nav = false
  endif
%}

<section id="hero" class="parallax-item fixed inset-x-0 top-0 z-[5] h-[100svh] min-h-0 w-full overflow-hidden"
      data-start="12"
      data-end="-12"
      data-scrub="0.8"
      aria-label="{{ 'sections.hero.aria_label' | t }}">
  {% if section.blocks.size == 0 %}
    {% if request.design_mode %}
      <div class="flex h-full min-h-[100svh] items-center justify-center bg-zinc-800 px-6 text-center text-white">
        <p>Bu bölümde en az bir «Slayt» bloğu ekleyin; medya ve metin alanlarını doldurun.</p>
      </div>
    {% endif %}
  {% else %}
    <div
      class="swiper hero-main h-full w-full parallax-content"
      data-hero-pagination="{% if show_pag %}true{% else %}false{% endif %}"
      data-hero-navigation="{% if show_nav %}true{% else %}false{% endif %}"
    >
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% liquid
            assign v_items_raw = block.settings.vertical_position | strip
            if v_items_raw == blank
              assign v_items_raw = 'items-center'
            endif
            assign v_items = 'max-lg:items-end max-lg:pb-28 lg:' | append: v_items_raw

            assign h_raw = block.settings.horizontal_position | strip
            assign h_parts = h_raw | split: '|'
            assign h_outer = h_parts[0] | strip
            assign copy_margin = h_parts[1] | strip
            assign sub_extra = h_parts[2] | strip
            if h_outer == blank
              assign h_outer = 'justify-start text-left'
            endif
            if copy_margin == blank
              assign copy_margin = 'ml-0 mr-auto'
            endif

            if h_outer contains 'text-right'
              assign text_align_cls = 'text-right items-end'
            elsif h_outer contains 'text-center'
              assign text_align_cls = 'text-center'
            else
              assign text_align_cls = 'text-left'
            endif

            assign layout_theme = block.settings.theme | strip | downcase
            if layout_theme != 'light' and layout_theme != 'dark'
              assign layout_theme = 'dark'
            endif

            assign layout_extra = block.settings.class_name | strip

            if layout_theme == 'light'
              assign title_clr = 'text-zinc-900'
              assign sub_clr = 'text-zinc-800/95'
            else
              assign title_clr = 'text-white'
              assign sub_clr = 'text-white/95'
            endif

            assign slide_loading = 'eager'
            if hero_lazy_after_first and forloop.index > 1
              assign slide_loading = 'lazy'
            endif

            assign mref = block.settings.slide_media
            assign media_type_str = ''
            if mref != blank
              assign media_type_str = mref.type | strip | downcase
            endif

            assign thumb_url = blank
            if mref != blank
              if mref.mobile_image != blank
                assign thumb_url = mref.mobile_image | image_url: width: 400
              elsif mref.desktop_image != blank
                assign thumb_url = mref.desktop_image | image_url: width: 400
              elsif media_type_str == 'video'
                if mref.desktop_video_poster != blank
                  assign thumb_url = mref.desktop_video_poster | image_url: width: 400
                elsif mref.mobile_video_poster != blank
                  assign thumb_url = mref.mobile_video_poster | image_url: width: 400
                endif
              endif
            endif

            assign media_wrap = hero_media_layer_extra_class
            if mref != blank and mref.class_name != blank
              if media_wrap != blank
                assign media_wrap = media_wrap | append: ' ' | append: mref.class_name
              else
                assign media_wrap = mref.class_name
              endif
            endif
          %}

          <div
            class="swiper-slide relative h-full w-full overflow-hidden"
            {{ block.shopify_attributes }}
            {% if thumb_url != blank %}data-thumb="{{ thumb_url }}"{% endif %}
            {% if media_type_str == 'video' %}data-hero-video="true"{% endif %}
          >
            {% render 'media',
              media: mref,
              loading: slide_loading,
              aspect_ratio_class: hero_media_aspect_ratio_class,
              wrapper_extra_class: media_wrap
            %}
            <div class="absolute inset-0 bg-[rgba(0,0,0,.02)] z-[1] pointer-events-none"></div>
            <div class="hero-slide-content absolute inset-0 z-[2] flex {{ v_items }} {{ h_outer }} {{ layout_extra }}">
              <div class="hero-slide-copy w-full flex flex-col max-w-[min(100%,560px)] px-5 lg:px-10 pt-0 lg:pt-[88px] {{ text_align_cls }} {{ copy_margin }} will-change-transform">
                {% if block.settings.title != blank %}
                  <h2 class="max-w-[16ch] {{ text_align_cls }} text-[clamp(1.5rem,3vw,3.2rem)] font-bold leading-[1.12] tracking-tight {{ title_clr }}">
                    {{ block.settings.title | newline_to_br }}
                  </h2>
                {% endif %}
                {% if block.settings.subtitle != blank %}
                  <p class="mt-2 lg:mt-4 max-w-[36ch] {{ text_align_cls }} text-base lg:text-lg font-normal leading-relaxed hidden lg:block {{ sub_clr }} {{ sub_extra }}">
                    {{ block.settings.subtitle | newline_to_br }}
                  </p>
                {% endif %}
                {% capture hero_btn_wrapper %}buttons mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap {{ text_align_cls }}{% endcapture %}
                {% assign hero_slide_buttons = block.settings.slide_buttons %}
                {% if hero_slide_buttons != blank and hero_slide_buttons.size > 0 %}
                  <div class="{{ hero_btn_wrapper }}">
                    {% for button in hero_slide_buttons %}
                      {% render 'button', button: button, theme: layout_theme, size_class: 'text-lg font-bold' %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    {% if show_pag or show_nav %}
      <div class="pointer-events-auto absolute bottom-5 lg:bottom-[6vh] left-5 lg:left-10 z-[90] flex items-center gap-3 md:gap-4" id="hero-thumb-bar" role="tablist" aria-label="{{ 'sections.hero.slide_tabs' | t }}">
        {% if show_pag %}
          <div id="hero-pagination-custom" class="flex items-center gap-3 md:gap-4"></div>
        {% endif %}
        {% if show_nav %}
          <button type="button" id="hero-next" class="ml-1 flex h-10 w-10 items-center justify-center rounded-full border border-white/50 text-white hover:bg-white/10 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" aria-label="{{ 'sections.hero.next_slide' | t }}">
            <span class="text-lg font-normal leading-none" aria-hidden="true"><img src="{{ 'icons/right-arrow.svg' | asset_url }}" width="24" height="24" alt="" loading="lazy"></span>
          </button>
        {% endif %}
      </div>
    {% endif %}

    <div id="scroll-wrapper" class="absolute z-[90] pointer-events-none right-4 bottom-0 hidden lg:block" aria-hidden="true">
      <div id="scroll-wrapper-inner" class="table-cell align-bottom">
        <div id="scroll-title" class="block uppercase text-white text-xs font-semibold text-center transform rotate-90 mb-6">
          Kaydir
        </div>
        <div id="scroll-down" class="block relative pt-10 text-center"></div>
      </div>
    </div>
  {% endif %}
</section>
<div class="hero-scroll-spacer" aria-hidden="true"></div>

{% schema %}
{
  "name": "Vitrin — hero kaydırmalı",
  "tag": "div",
  "class": "landing-hero-section",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slayt",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Başlık"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Alt başlık"
        },
        {
          "type": "metaobject",
          "id": "slide_media",
          "label": "Medya",
          "metaobject_type": "media"
        },
        {
          "type": "metaobject_list",
          "id": "slide_buttons",
          "label": "Butonlar",
          "metaobject_type": "button",
          "limit": 8
        },
        {
          "type": "select",
          "id": "theme",
          "label": "Tema (metin rengi / buton)",
          "options": [
            { "value": "dark", "label": "Koyu (açık metin)" },
            { "value": "light", "label": "Açık (koyu metin)" }
          ],
          "default": "dark"
        },
        {
          "type": "text",
          "id": "class_name",
          "label": "Ek Tailwind sınıfları (içerik sarmalayıcı)",
          "info": "Örn. gap-4 veya md:px-16. Boş bırakılabilir."
        },
        {
          "type": "select",
          "id": "vertical_position",
          "label": "Dikey hizalama (Tailwind)",
          "options": [
            { "value": "items-start", "label": "Üst" },
            { "value": "items-center", "label": "Orta" },
            { "value": "items-end", "label": "Alt" }
          ],
          "default": "items-center"
        },
        {
          "type": "select",
          "id": "horizontal_position",
          "label": "Yatay hizalama",
          "info": "Değer: dış flex + metin | kopya kutusu margin | alt başlık ek margin (| ile ayrılmış Tailwind sınıfları). Özelleştirirken bu yapıyı koruyun.",
          "options": [
            {
              "value": "justify-start text-left|ml-0 mr-auto|",
              "label": "Sol"
            },
            {
              "value": "justify-center text-center|mx-auto|mx-auto",
              "label": "Orta"
            },
            {
              "value": "justify-end text-right|ml-auto mr-0|ml-auto",
              "label": "Sağ"
            }
          ],
          "default": "justify-start text-left|ml-0 mr-auto|"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vitrin — hero kaydırmalı",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "title": "Rahatlıkla Büyüyen Mutlu Adımlar.",
            "subtitle": "Her yolculukta, hem sizin hem bebeğinizin mutluluğu için tasarlandı.",
            "theme": "dark",
            "vertical_position": "items-center",
            "horizontal_position": "justify-start text-left|ml-0 mr-auto|"
          }
        },
        {
          "type": "slide",
          "settings": {
            "title": "Yeni sezonda %30’a varan indirim.",
            "subtitle": "En yeni modeller şimdi avantajlı fiyatlarla.",
            "theme": "dark",
            "vertical_position": "items-center",
            "horizontal_position": "justify-start text-left|ml-0 mr-auto|"
          }
        }
      ]
    }
  ]
}
{% endschema %}
