<section id="popular-split-bg-section" class="bg-custom-color text-neutral-900 relative z-10" aria-label="{{ 'sections.popular.aria_label' | t }}" style="--pcp-pad-x: 40px;">
  <div class="mx-auto p-0">
    <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] lg:items-start relative">
      <article class="overflow-hidden bg-custom-color lg:bg-[#eae7dd]">
        {% if section.settings.heading != blank %}
          <div class="lg:absolute lg:left-0 top-0 z-10 bg-custom-color px-8 py-6 md:px-24 md:py-8">
            <h2 class="font-semibold lg:font-medium leading-tight tracking-tight text-neutral-800 text-4xl lg:text-[40px] text-center lg:text-left">
              {{ section.settings.heading | escape }}
            </h2>
          </div>
        {% endif %}
        <div
          class="parallax-item relative overflow-hidden aspect-[1/1]"
          data-start="-12"
          data-end="12"
          data-scrub="0.8"
        >
          <div class="parallax-content absolute inset-0">
            {% if section.settings.cover_image != blank %}
              {% liquid
                assign cover_alt = section.settings.cover_image_alt | strip
                if cover_alt == blank
                  assign cover_alt = 'sections.popular.feature_alt' | t
                endif
              %}
              <img
                src="{{ section.settings.cover_image | image_url: width: 1600 }}"
                alt="{{ cover_alt | escape }}"
                class="h-full w-full object-cover object-center"
                width="1200"
                height="700"
                loading="lazy"
                decoding="async"
              >
            {% elsif request.design_mode %}
              <div class="flex h-full min-h-[40vw] items-center justify-center bg-[#e0ddd6] text-sm text-neutral-500">
                Kapak görseli seçin
              </div>
            {% endif %}
          </div>
        </div>
        
      </article>

      {% render 'product-spotlight-card',
        product: section.settings.spotlight_product,
        aria_title_id: 'popular-spotlight-title',
        article_class: 'mt-[-40px] lg:mt-0 relative z-10 px-5 lg:px-10 lg:py-[100px] lg:sticky top-0 lg:max-w-[550px] lg:mx-auto',
        scroll_motion: false
      %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Popüler — iki sütun",
  "tag": "div",
  "class": "landing-popular-split-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Kapak görseli (sol)"
    },
    {
      "type": "text",
      "id": "cover_image_alt",
      "label": "Kapak görseli — alt metin",
      "info": "Boşsa tema çevirisi kullanılır."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Popüler Seçimler"
    },
    {
      "type": "product",
      "id": "spotlight_product",
      "label": "Öne çıkan ürün (sağ)"
    }
  ],
  "presets": [{ "name": "Popüler — iki sütun" }]
}
{% endschema %}
