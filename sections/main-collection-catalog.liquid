{% comment %}
  Koleksiyon kataloğu — üstte tüm koleksiyonlar (yatay), ortada ürün grid + sayfalama, altta SEO metni (collection.description).
  Sıralama: Shopify `sort_by` (GET form, collection.sort_options).
  Filtre yok; ürün kartı: snippets/product-list-card.liquid
{% endcomment %}
<section
  class="main-collection-catalog bg-custom-color text-neutral-900"
  aria-label="{{ 'sections.collection_catalog.aria_label' | t }}"
  data-section-id="{{ section.id }}"
>
  {% if collection.metafields.custom.cover_image.value != blank %}
    {% assign cover_desktop = collection.metafields.custom.cover_image.value %}
    {% assign cover_mobile = collection.metafields.custom.cover_mobile_image.value %}
    <header class="lg:mb-1 flex flex-wrap items-center justify-between gap-4 relative">
      <div class="flex w-full flex-col gap-2 absolute bottom-0 left-0 z-[2] lg:px-24 px-5 lg:py-10 py-5">
        <h1 class="w-full min-w-0 text-3xl text-white font-medium tracking-tight md:flex-1 md:text-4xl">
          {{ collection.metafields.custom.cover_image_title | escape }}
        </h1>
        <span class="text-base text-white font-light">
          {{ collection.metafields.custom.cover_image_description }}
        </span>
      </div>
      <div class="relative aspect-[450/720] w-full overflow-hidden lg:aspect-auto">
        <div class="absolute inset-0 bg-[rgba(0,0,0,.1)] z-[1] pointer-events-none"></div>
        <picture>
          {% if cover_mobile != blank %}
            <source
              media="(max-width: 1023px)"
              srcset="{{ cover_mobile | image_url: width: 450 }} 450w, {{ cover_mobile | image_url: width: 900 }} 900w"
              sizes="100vw"
            >
          {% endif %}
          <img
            src="{{ cover_desktop | image_url: width: 2172 }}"
            alt="{{ cover_desktop.alt | default: collection.title | escape }}"
            class="absolute inset-0 z-0 h-full w-full object-cover lg:relative lg:inset-auto lg:z-auto lg:h-auto lg:w-full"
            width="{{ cover_desktop.width }}"
            height="{{ cover_desktop.height }}"
            loading="eager"
            decoding="async"
          >
        </picture>
      </div>
    </header>
    <script>
      document.body.classList.add('list-cover-image');
    </script>
  {% endif %}
  <div class="mx-auto max-w-[1680px] px-5 lg:px-10 pb-16 pt-5 lg:pt-12 lg:pb-24 lg:pt-4">
    {% render 'breadcrumbs', current_title: collection.title %}
    <div class="mb-5 lg:mb-10 flex min-w-0 w-full flex-col items-center justify-between gap-y-4 lg:flex-row lg:gap-y-0">
      {% assign found_products_count = collection.products_count
        | default: collection.all_products_count
        | default: collection.products.size
      %}
      <nav
        class="collection-all-categories w-full min-w-0 max-w-full overflow-x-auto [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden hidden lg:flex"
        aria-label="{{ 'templates.collection.category_nav_aria' | t }}"
      >
        <ul class="flex min-w-0 flex-nowrap gap-2 pb-1 md:flex-wrap md:gap-3" role="list">
          {% for col in collections %}
            {% unless col.handle == 'frontpage' %}
              <li class="shrink-0">
                <a
                  href="{{ col.url }}"
                  class="inline-flex items-center rounded-full border px-4 py-2 text-sm font-medium transition-colors{% if col.handle == collection.handle %} border-neutral-900 bg-neutral-900 text-white{% else %} border-neutral-200 text-neutral-800 hover:border-neutral-400 hover:opacity-90{% endif %}"
                  {% if col.handle == collection.handle %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- col.title | escape -}}
                </a>
              </li>
            {% endunless %}
          {% endfor %}
        </ul>
      </nav>

      <div class="flex w-full items-center justify-end gap-3 sm:gap-4 md:w-auto">
        {% comment %}
          <span class="shrink-0 text-sm font-light text-neutral-700">
            {{ found_products_count }} ürün bulundu
          </span>
        {% endcomment %}
        {% if collection.sort_options.size > 0 %}
          <form
            class="collection-sort-form shrink-0"
            method="get"
            action="{{ collection.url }}"
            aria-label="{{ 'templates.collection.sort_by_label' | t }}"
          >
            <label class="sr-only" for="CollectionSort-{{ section.id }}">
              {{- 'templates.collection.sort_by_label' | t -}}
            </label>
            <select
              id="CollectionSort-{{ section.id }}"
              name="sort_by"
              class="max-w-[min(100vw-5rem,220px)] cursor-pointer appearance-none bg-transparent py-2 pl-3 pr-3 text-right text-sm font-medium text-neutral-900 [background-image:none] [-webkit-appearance:none] transition-colors focus-visible:outline-none focus-visible:ring-0"
              onchange="this.form.submit()"
            >
              <option value="" disabled selected>
                {{- 'templates.collection.sort_placeholder' | t -}}
              </option>
              {% for option in collection.sort_options %}
                <option value="{{ option.value | escape }}">
                  {{ option.name | escape }}
                </option>
              {% endfor %}
            </select>
            <script>
              (function () {
                var el = document.getElementById('CollectionSort-{{ section.id }}');
                if (!el) return;
                try {
                  var sortBy = new URLSearchParams(window.location.search).get('sort_by');
                  if (sortBy) {
                    for (var i = 0; i < el.options.length; i++) {
                      if (el.options[i].value === sortBy) {
                        el.selectedIndex = i;
                        break;
                      }
                    }
                  } else {
                    el.selectedIndex = 0;
                  }
                } catch (e) {}
              })();
            </script>
          </form>
        {% endif %}
        <div
          id="collection-grid-toggles-{{ section.id }}"
          class="flex shrink-0 items-center gap-1 hidden lg:flex"
          role="group"
          aria-label="{{ 'templates.collection.grid_view_group_aria' | t }}"
        >
          <button
            type="button"
            class="collection-grid-toggle inline-flex h-auto w-auto items-center justify-center rounded-full border !border-transparent hover:!border-[#dbd2c3] bg-transparent transition-colors aria-[pressed=true]:border-transparent aria-[pressed=true]:bg-[#dbd2c3] aria-[pressed=false]:border-[#dbd2c3] aria-[pressed=false]:bg-transparent"
            data-collection-grid-cols="3"
            aria-pressed="true"
            aria-label="{{ 'templates.collection.grid_view_3_aria' | t }}"
          >
            <img
              src="{{ 'icons/grid-view-3.svg' | asset_url }}"
              width="32"
              height="32"
              alt=""
              class=""
              aria-hidden="true"
            >
          </button>
          <button
            type="button"
            class="collection-grid-toggle inline-flex h-auto w-auto items-center justify-center rounded-full border !border-transparent hover:!border-[#dbd2c3] bg-transparent transition-colors aria-[pressed=true]:border-transparent aria-[pressed=true]:bg-[#dbd2c3] aria-[pressed=false]:border-[#dbd2c3] aria-[pressed=false]:bg-transparent"
            data-collection-grid-cols="4"
            aria-pressed="false"
            aria-label="{{ 'templates.collection.grid_view_4_aria' | t }}"
          >
            <img
              src="{{ 'icons/grid-view-4.svg' | asset_url }}"
              width="32"
              height="32"
              alt=""
              class=""
              aria-hidden="true"
            >
          </button>
        </div>
      </div>
      <script>
        (function () {
          try {
            var is4 = document.documentElement.classList.contains('prava-collection-grid-4');
            var group = document.getElementById('collection-grid-toggles-{{ section.id }}');
            if (!group || group.getAttribute('role') !== 'group') return;
            var b3 = group.querySelector('[data-collection-grid-cols="3"]');
            var b4 = group.querySelector('[data-collection-grid-cols="4"]');
            if (b3) b3.setAttribute('aria-pressed', is4 ? 'false' : 'true');
            if (b4) b4.setAttribute('aria-pressed', is4 ? 'true' : 'false');
          } catch (e) {}
        })();
      </script>
    </div>

    <div aria-label="{{ 'templates.collection.products_region_aria' | t }}">
      {% paginate collection.products by section.settings.products_per_page %}
        {% if collection.products.size == 0 %}
          {% assign collection_empty_image_url = 'not-found.png' | file_url %}
          <div class="flex flex-col items-center justify-center py-10 md:py-14">
            {% if collection_empty_image_url != blank %}
              <img
                src="{{ collection_empty_image_url }}"
                alt="{{ 'templates.collection.empty' | t | escape }}"
                class="w-full max-w-[360px] h-auto object-contain"
                width="360"
                height="360"
                loading="lazy"
                decoding="async"
              >
              <p class="text-xl mt-10 text-neutral-600">{{ 'templates.collection.empty' | t }}</p>
            {% endif %}
          </div>
        {% else %}
          {% assign banner = collection.metafields.custom.collection_banner.value %}
          <div
            class="grid grid-cols-1 gap-5 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-6 xl:grid-cols-3 xl:[&.is-collection-grid-4]:grid-cols-4"
            data-collection-product-grid
          >
            <script>
              (function () {
                try {
                  var g = document.currentScript && document.currentScript.parentElement;
                  if (g && document.documentElement.classList.contains('prava-collection-grid-4')) {
                    g.classList.add('is-collection-grid-4');
                  }
                } catch (e) {}
              })();
            </script>
            {% for product in collection.products %}
              {% if forloop.index <= 3 %}
                {%
                  render 'product-list-card',
                  product: product,
                  title_id: 'col-prod-' | append: product.id,
                  image_loading: 'eager'
                %}
              {% else %}
                {%
                  render 'product-list-card',
                  product: product,
                  title_id: 'col-prod-' | append: product.id,
                  image_loading: 'lazy'
                %}
              {% endif %}

              {% if banner != blank and paginate.current_page == 1 %}
                {% liquid
                  assign promo_after_index = 5
                  if collection.products.size < 5
                    assign promo_after_index = collection.products.size
                  endif
                %}
                {% if forloop.index == promo_after_index %}
                  {% render 'collection-inline-promo-banner', banner: banner %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav
              class="mt-14 flex flex-wrap items-center justify-center gap-2"
              aria-label="{{ 'general.pagination.nav_aria' | t }}"
            >
              {% if paginate.previous %}
                <a
                  href="{{ paginate.previous.url }}"
                  class="rounded border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-800 transition-opacity hover:opacity-70"
                >
                  {{ 'general.pagination.previous' | t }}
                </a>
              {% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a
                    href="{{ part.url }}"
                    class="min-w-[2.5rem] rounded border border-neutral-200 px-3 py-2 text-center text-sm text-neutral-800 transition-opacity hover:opacity-70"
                  >
                    {{- part.title -}}
                  </a>
                {% else %}
                  {% if part.title == paginate.current_page %}
                    <span
                      class="min-w-[2.5rem] rounded border border-neutral-900 bg-neutral-900 px-3 py-2 text-center text-sm font-medium text-white"
                      aria-current="page"
                    >
                      {{- part.title -}}
                    </span>
                  {% else %}
                    <span class="min-w-[2.5rem] px-2 py-2 text-center text-sm text-neutral-400">{{ part.title }}</span>
                  {% endif %}
                {% endif %}
              {% endfor %}
              {% if paginate.next %}
                <a
                  href="{{ paginate.next.url }}"
                  class="rounded border border-neutral-200 px-4 py-2 text-sm font-medium text-neutral-800 transition-opacity hover:opacity-70"
                >
                  {{ 'general.pagination.next' | t }}
                </a>
              {% endif %}
            </nav>
          {% endif %}
        {% endif %}
      {% endpaginate %}
    </div>

    {% if collection.description != blank %}
      <div class="rte mt-14 max-w-3xl text-base font-light leading-relaxed text-neutral-600 [&_a]:underline [&_a]:underline-offset-4 md:mt-16">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_catalog.name",
  "tag": "section",
  "class": "section-collection-catalog",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 24,
      "label": "t:sections.collection_catalog.settings.products_per_page.label"
    }
  ]
}
{% endschema %}
