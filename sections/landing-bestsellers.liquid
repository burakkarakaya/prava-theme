<section class="prava-bestsellers bg-custom-color text-neutral-900" aria-label="{{ 'sections.bestsellers.aria_label' | t }}" style="--pbs-pad-x: 40px;">
  <div class="mx-auto max-w-[1680px] px-5 lg:px-[var(--pbs-pad-x)] pt-16 lg:pt-44 pb-10 lg:pb-24">
    {% liquid
      assign cta_href = section.settings.cta_url | strip
      if cta_href == blank
        assign cta_href = routes.all_products_collection_url
      endif
      assign cta_visible = section.settings.cta_label | strip
      if cta_visible == blank
        assign cta_visible = 'sections.bestsellers.cta_all_visible' | t
      endif
    %}
    <div class="flex flex-col gap-3 lg:gap-6 sm:flex-row sm:items-end sm:justify-between">
      {% if section.settings.heading != blank %}
        <h2 class="font-semibold lg:font-medium tracking-tight text-neutral-900 text-4xl lg:text-[40px]">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}
      <a
        href="{{ cta_href }}"
        class="shrink-0 text-left text-base lg:text-lg font-light text-neutral-800 underline decoration-neutral-800 underline-offset-[5px] transition-opacity hover:opacity-70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 sm:text-right"
        aria-label="{{ 'sections.bestsellers.cta_all' | t }}"
      >
        {{ cta_visible }}
      </a>
    </div>
    <div class="prava-bestsellers__viewport prava-swiper-widget mt-10 md:mt-14">
      {% render 'swiper-widget-arrows' %}
      <div class="swiper prava-bestsellers__swiper w-full">
        <div class="swiper-wrapper">
          {% assign first_bestseller_slide = 'yes' %}
          {% for block in section.blocks %}
            {% if block.settings.product != blank or request.design_mode %}
              <div class="swiper-slide !h-auto">
                {% if first_bestseller_slide == 'yes' %}
                  {% assign first_bestseller_slide = 'no' %}
                  {% render 'product-list-card',
                    product: block.settings.product,
                    block: block,
                    title_id: 'bs-prod-title-' | append: block.id,
                    hover_image: block.settings.hover_image,
                    hover_video_url: block.settings.hover_video_url,
                    image_loading: 'eager'
                  %}
                {% else %}
                  {% render 'product-list-card',
                    product: block.settings.product,
                    block: block,
                    title_id: 'bs-prod-title-' | append: block.id,
                    hover_image: block.settings.hover_image,
                    hover_video_url: block.settings.hover_video_url,
                    image_loading: 'lazy'
                  %}
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Çok satanlar şeridi",
  "tag": "div",
  "class": "landing-bestsellers-section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "En Çok Satılanlar"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tümünü gör — bağlantı",
      "info": "Boş bırakılırsa tüm koleksiyonlar sayfası kullanılır."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Tümünü gör — metin",
      "info": "Boş bırakılırsa tema çevirisi (cta_all_visible) kullanılır."
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Ürün",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Ürün"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover görseli",
          "info": "Üzerine gelince gösterilir. Hover videosu doluysa video önceliklidir."
        },
        {
          "type": "url",
          "id": "hover_video_url",
          "label": "Hover videosu (MP4 URL)",
          "info": "Doluysa hover görseli yerine video oynatılır."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Çok satanlar şeridi",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
