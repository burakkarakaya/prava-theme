{% comment %}
  CMS sayfası — templates/page.json
  Sol menü: snippets/page-sibling-nav.liquid (footer menüsü, aynı seviye kardeşler)
{% endcomment %}
{%- capture sibling_nav_markup -%}
  {%- render 'page-sibling-nav', section_id: section.id -%}
{%- endcapture -%}
{%- assign sibling_nav_stripped = sibling_nav_markup | strip -%}

<section
  class="main-page bg-custom-color text-neutral-900"
  aria-label="{{ 'sections.main_page.aria_label' | t }}"
>
  <div class="mx-auto max-w-[1100px] px-5 lg:px-10 pb-16 pt-5 lg:pt-12 md:pb-24 md:pt-16">
    <div
      class="{% if sibling_nav_stripped != blank %}lg:grid lg:grid-cols-[minmax(0,220px)_minmax(0,1fr)] lg:gap-x-14 xl:grid-cols-[minmax(0,260px)_minmax(0,1fr)] xl:gap-x-16{% endif %}"
    >
      {%- if sibling_nav_stripped != blank -%}
        {{- sibling_nav_markup -}}
      {%- endif -%}

      <div class="min-w-0">
        {% render 'breadcrumbs', current_title: page.title %}

        <header class="lg:border-b lg:border-neutral-200/90 pb-2 lg:pb-8">
          <h1 class="text-2xl font-medium leading-tight tracking-tight text-neutral-900 md:text-4xl">
            {{ page.title | escape }}
          </h1>
        </header>

        <div
          class="main-page__body rte mt-2 lg:mt-10 text-base leading-relaxed text-neutral-800 md:text-lg [&_a]:text-neutral-900 [&_a]:underline [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-medium [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-medium [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6"
        >
          {{ page.content }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section-main-page",
  "settings": []
}
{% endschema %}
