{% comment %}
  main-product-detail — Shopify ürün detay (PDP) ana bölümü.

  Ne işe yarar?
  - Sol: medya galerisi (tek Swiper DOM; mobil swipe, md+ CSS grid).
  - Sağ: başlık (tek h1), açıklama, taksit metni (Shopify payment_terms), sepete ekle formu, fiyat.
  - Renk grupları ayrı ürün URL’leri (metafield: snippets/product-color-variants); sayfada tek Shopify varyantı (gizli id).
  - Aşağıda: metafield tabanlı özellik slider, accordion (boyutlar/özellikler/güvenlik), isteğe bağlı 360° görsel (Cloudimage 360 View), benzer ürünler, destek SSS.

  JS (assets/product-detail.js): Ajax sepete ekleme; [data-prava-pdp] + ProductForm-{section.id}.
{% endcomment %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant

  # Breadcrumb: üst link için ürünün ilk koleksiyonu
  assign parent_col = product.collections.first

  # Sepet formu id + taksit formu id (aynı sayfada iki form; id’ler benzersiz)
  assign product_form_id = 'ProductForm-' | append: section.id
  assign installment_form_id = 'ProductInstallment-' | append: section.id
%}

{% comment %} PDP çevirileri (paylaş / favori); product-detail.js bunları okur {% endcomment %}
<script>
  window.PRAVA_I18N = window.PRAVA_I18N || {};
  Object.assign(window.PRAVA_I18N, {
    pdp_share_copied: {{ 'products.share_copied' | t | json }},
    pdp_share_failed: {{ 'products.share_failed' | t | json }},
    pdp_wishlist_added: {{ 'products.wishlist_added_alert' | t | json }},
    pdp_wishlist_removed: {{ 'products.wishlist_removed_alert' | t | json }},
    pdp_gallery_modal_title: {{ 'products.gallery_modal_title' | t | json }},
    pdp_gallery_modal_close: {{ 'products.gallery_modal_close' | t | json }},
    pdp_gallery_modal_prev: {{ 'products.gallery_modal_prev' | t | json }},
    pdp_gallery_modal_next: {{ 'products.gallery_modal_next' | t | json }}
  });
</script>
{% comment %} Ajax sepete ekleme (product-detail.js) {% endcomment %}
<script src="{{ 'product-detail.js' | asset_url }}" defer="defer"></script>

<section
  class="prava-pdp bg-custom-color text-neutral-900"
  data-prava-pdp
  data-section-id="{{ section.id }}"
  aria-label="{{ 'sections.product_detail.aria_label' | t }}"
>
  <div class="mx-auto">

    <div class="grid grid-cols-1 lg:grid-cols-2 lg:items-start">
      {% comment %}
        Sol sütun — Tek Swiper iskeleti: mobilde swipe (slidesPerView auto, boyutlar CSS);
        md+ breakpoint’te JS devre dışı, wrapper CSS grid (1 + 2 sütun).
      {% endcomment %}
      <div
        class="prava-pdp__gallery min-w-0 lg:sticky lg:top-24 lg:z-[1] lg:self-start"
        data-prava-pdp-gallery
      >
        {% if product.media.size == 0 %}
          <div class="overflow-hidden bg-white">
            <div class="flex aspect-square items-center justify-center bg-neutral-100 text-neutral-500">
              {{ 'products.no_image' | t }}
            </div>
          </div>
        {% else %}
          <div
            class="swiper prava-pdp__gallery-swiper w-full overflow-hidden md:overflow-visible"
            id="PdpGallerySwiper-{{ section.id }}"
            data-prava-pdp-gallery-swiper
            role="region"
            aria-label="{{ 'products.gallery_thumbnails' | t }}"
          >
            <div class="swiper-wrapper prava-pdp__gallery-wrapper">
              {% liquid
                assign gallery_image_total = 0
                for m in product.media
                  if m.media_type == 'image'
                    assign gallery_image_total = gallery_image_total | plus: 1
                  endif
                endfor
                assign gallery_image_idx = 0
              %}
              {% for media in product.media %}
                {% liquid
                  if forloop.first
                    assign media_loading = 'eager'
                  else
                    assign media_loading = 'lazy'
                  endif
                %}
                <div
                  class="swiper-slide prava-pdp__gallery-slide !h-auto"
                  data-media-id="{{ media.id }}"
                >
                  <div
                    class="prava-swiper-card__media overflow-hidden bg-product-color"
                    data-prava-pdp-media
                    data-media-id="{{ media.id }}"
                  >
                    {% if media.media_type == 'image' %}
                      {% render 'pdp-gallery-media',
                        media: media,
                        product: product,
                        loading: media_loading,
                        gallery_modal_index: gallery_image_idx,
                        gallery_image_total: gallery_image_total
                      %}
                      {% assign gallery_image_idx = gallery_image_idx | plus: 1 %}
                    {% else %}
                      {% render 'pdp-gallery-media', media: media, product: product, loading: media_loading %}
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
            <div
              class="prava-pdp__gallery-pagination swiper-pagination !relative md:!hidden"
            ></div>
          </div>
        {% endif %}
      </div>

      {% comment %}
        Sağ sütun — Başlık (SEO: sayfada tek h1), isteğe bağlı satıcı, ürün açıklaması (RTE),
        ayrı taksit formu, ana sepet formu (gizli varyant id + miktar + fiyat + ATC).
      {% endcomment %}
      <div class="prava-pdp__info flex min-w-0 flex-col lg:sticky lg:top-24 lg:self-start max-w-[650px] py-5 lg:py-0 px-5 lg:px-[50px] mx-auto">
        {% if parent_col != blank %}
          {% render 'breadcrumbs',
            current_title: product.title,
            parent_title: parent_col.title,
            parent_url: parent_col.url
          %}
        {% else %}
          {% render 'breadcrumbs', current_title: product.title %}
        {% endif %}
        <header class="pb-6">
          <div class="flex flex-col lg:flex-row items-start justify-between gap-4">
            <h1
              class="min-w-0 flex-1 text-2xl font-semibold tracking-tight text-neutral-900 md:text-[34px] md:leading-tight"
            >
              {{ product.title | escape }}
            </h1>
            <div class="flex flex-col-reverse lg:flex-row shrink-0 items-center gap-1 pt-0.5 absolute right-3 top-[70px] lg:static z-10" role="group" aria-label="{{ 'products.pdp_actions_aria' | t }}">
              {% render 'pdp-share-dropdown', product: product, section_id: section.id %}
              {% if section.settings.browser_wishlist_enabled %}
                <button
                  type="button"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-md text-neutral-600 transition-colors hover:bg-neutral-200/50 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
                  data-prava-pdp-wishlist
                  data-product-handle="{{ product.handle | escape }}"
                  data-label-add="{{ 'products.wishlist_add' | t | escape }}"
                  data-label-remove="{{ 'products.wishlist_remove' | t | escape }}"
                  aria-pressed="false"
                  aria-label="{{ 'products.wishlist_add' | t }}"
                >
                  <span class="sr-only">{{ 'products.wishlist_add' | t }}</span>
                  <img
                    src="{{ 'icons/pdp-wishlist-heart.svg' | asset_url }}"
                    data-src-off="{{ 'icons/pdp-wishlist-heart.svg' | asset_url }}"
                    data-src-on="{{ 'icons/pdp-wishlist-heart-on.svg' | asset_url }}"
                    data-prava-wishlist-icon
                    alt=""
                    class="pointer-events-none h-8 w-8 shrink-0"
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                    aria-hidden="true"
                  >
                </button>
              {% endif %}
            </div>
          </div>
          {% if section.settings.show_vendor and product.vendor != blank %}
            <p class="mt-2 text-sm font-light text-neutral-600">{{ product.vendor | escape }}</p>
          {% endif %}
        </header>

        {% if product.description != blank %}
          <div class="product-description rte mb-6 text-base font-light leading-relaxed text-neutral-700">
            {{ product.description }}
          </div>
        {% endif %}

        {% render 'pdp-eligibility', product: product %}

        {% comment %}
          Taksit / ödeme koşulları: Shopify payment_terms için ürün formu ayrı bir form etiketi olarak tanımlanmalıdır.
          Gizli id tek satılabilir varyantı taşır (sayfada varyant seçici yok).
        {% endcomment %}
        <div class="mt-6">
          {% assign installment_variant_id = 'installment-variant-' | append: section.id %}
          {% form 'product', product, id: installment_form_id, class: 'installment-form text-sm text-neutral-600' %}
            <input type="hidden" name="id" id="{{ installment_variant_id }}" value="{{ current_variant.id }}">
            {{ form | payment_terms }}
          {% endform %}
        </div>

        {% comment %}
          Ana sepet formu: tek varyant (gizli id), gönder düğmesi name="add".
          Renk alternatifleri: snippets/product-color-variants (metafield custom.color_variants).
        {% endcomment %}
        {% form 'product', product, id: product_form_id, class: 'mt-8 flex flex-col gap-6' %}
          {% if form.errors %}
            <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert" tabindex="-1">
              <ul class="m-0 list-disc pl-5">
                {% for field in form.errors %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="flex items-center justify-between">
            <input type="hidden" name="id" value="{{ current_variant.id }}">

            {% render 'product-color-variants', product: product, section_id: section.id %}

            <input type="hidden" name="quantity" value="1">

            <div id="PdpPrice-{{ section.id }}" class="price-display" role="status">
              <p class="flex flex-col m-0 text-xl text-right font-semibold tracking-tight text-neutral-900">
                {% render 'price-with-compare', variant: current_variant, style: 'detail' %}
              </p>
            </div>
          </div>

          <button
            type="submit"
            name="add"
            id="PdpSubmit-{{ section.id }}"
            class="prava-pdp-atc-btn w-full rounded-xl border-0 py-4 text-center text-base font-semibold uppercase tracking-widest text-white transition-colors duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900 disabled:cursor-not-allowed disabled:opacity-50"
            aria-label="{% if current_variant.available %}{{ 'products.add_to_cart' | t | escape }}{% else %}{{ 'products.sold_out' | t | escape }}{% endif %}"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span class="prava-pdp-atc-btn__label" aria-hidden="true">
              {%- if current_variant.available -%}
                {{- 'products.add_to_cart' | t -}}
              {%- else -%}
                {{- 'products.sold_out' | t -}}
              {%- endif -%}
            </span>
          </button>
        {% endform %}

        {% comment %} Tema ayarlarından gelen kısa güven metinleri (kargo / iade / güvenli ödeme). {% endcomment %}
        <ul class="mt-8 flex flex-wrap gap-6 text-sm text-neutral-600 justify-center" role="list">
          {% if section.settings.trust_shipping != blank %}
            <li class="flex max-w-[200px] items-start gap-2">
              <span class="mt-0.5 shrink-0 text-neutral-800" aria-hidden="true">✓</span>
              <span>{{ section.settings.trust_shipping | escape }}</span>
            </li>
          {% endif %}
          {% if section.settings.trust_return != blank %}
            <li class="flex max-w-[200px] items-start gap-2">
              <span class="mt-0.5 shrink-0 text-neutral-800" aria-hidden="true">✓</span>
              <span>{{ section.settings.trust_return | escape }}</span>
            </li>
          {% endif %}
          {% if section.settings.trust_secure != blank %}
            <li class="flex max-w-[200px] items-start gap-2">
              <span class="mt-0.5 shrink-0 text-neutral-800" aria-hidden="true">✓</span>
              <span>{{ section.settings.trust_secure | escape }}</span>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>

    {% render 'pdp-feature-items', product: product %}

    {% render 'pdp-accordion', product: product %}

    {% render 'pdp-360-viewer', product: product, section_id: section.id %}

    {% render 'pdp-collection-recommendations', product: product, limit: 8 %}

    {% render 'product-faq-items', product: product %}
  </div>

  {% render 'product-color-variants-json-ld', product: product %}
</section>

{% schema %}
{
  "name": "Ürün detay (ana)",
  "tag": "section",
  "class": "main-product-detail-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Satıcı adını göster",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "browser_wishlist_enabled",
      "label": "Üründe tarayıcı favori düğmesi",
      "default": true,
      "info": "Shopify’da müşteri hesabına bağlı yerel ürün favori listesi bulunmaz; kalıcı favori için App Store’daki wishlist uygulamaları kullanılır. Bu seçenek yalnızca ziyaretçinin tarayıcısında liste tutar. Uygulama snippet’leri için bu düğmeyi kapatıp uygulama belgesine göre yerleştirme yapılabilir."
    },
    {
      "type": "header",
      "content": "Güven metinleri (satır altı)"
    },
    {
      "type": "text",
      "id": "trust_shipping",
      "label": "Kargo",
      "default": "Ücretsiz kargo"
    },
    {
      "type": "text",
      "id": "trust_return",
      "label": "İade",
      "default": "Kolay iade"
    },
    {
      "type": "text",
      "id": "trust_secure",
      "label": "Güvenlik",
      "default": "Güvenli alışveriş"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Ürün detay sayfası"
    }
  ]
}
{% endschema %}
