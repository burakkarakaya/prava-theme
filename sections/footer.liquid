{% assign footer_year = 'now' | date: '%Y' %}
{% liquid
  assign newsletter_heading = section.settings.newsletter_heading
  if newsletter_heading == blank
    assign newsletter_heading = 'footer.newsletter_heading' | t
  endif
%}
{% assign footer_menu = linklists['footer'] %}
{% assign footer_bottom_menu = linklists['footer-bottom-menu'] %}
{% liquid
  assign footer_show_language = false
  if localization.available_languages.size > 1
    assign footer_show_language = true
  endif
  assign footer_show_bottom_nav = false
  if footer_bottom_menu.links.size > 0
    assign footer_show_bottom_nav = true
  endif
%}
<footer
  class="site-footer mt-auto bg-product-color text-[#333333] z-[50]"
  role="contentinfo"
  aria-label="{{ 'footer.aria_label' | t }}"
  style="--footer-pad-x: 40px;"
>
  {% if settings.footer_watermark_image != blank %}
    <div class="lg:px-16 mx-auto site-footer__watermark" aria-hidden="true">
      <img
        src="{{ settings.footer_watermark_image | image_url: width: 2400 }}"
        alt=""
        width="{{ settings.footer_watermark_image.width }}"
        height="{{ settings.footer_watermark_image.height }}"
        loading="lazy"
        decoding="async"
      >
    </div>
  {% endif %}
  <div class="mx-auto px-5 lg:px-20 pb-6 pt-10 lg:pt-20">
    <div class="grid grid-cols-1 gap-0 lg:gap-14 md:grid-cols-2 xl:grid-cols-4">
      {% if section.settings.newsletter_enable or section.settings.show_social %}
        <div class="site-footer__col site-footer__col--news lg:max-w-[300px]">
          {% if section.settings.newsletter_enable %}
            <h3 class="text-lg font-bold uppercase text-[#333333]">{{ newsletter_heading }}</h3>
            {% form 'customer', class: 'mt-6' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="sr-only" for="footer-newsletter-email-{{ section.id }}">{{ 'footer.newsletter_email_label' | t }}</label>
              <div class="site-footer__field flex overflow-hidden rounded-lg bg-[#f4f4f4]">
                <input
                  id="footer-newsletter-email-{{ section.id }}"
                  name="contact[email]"
                  type="email"
                  autocomplete="email"
                  placeholder="{{ 'footer.newsletter_placeholder' | t }}"
                  class="site-footer__input min-w-0 flex-1 border-0 bg-transparent px-4 py-3.5 text-sm text-[#333333] placeholder:text-neutral-500 outline-none"
                  required
                >
                <button type="submit" class="site-footer__submit flex shrink-0 items-center justify-center px-4 text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.newsletter_submit_aria' | t }}">
                  <img src="{{ 'icons/right-arrow.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5 invert" loading="lazy">
                </button>
              </div>
            {% endform %}
            <p class="mt-3 max-w-sm text-base leading-relaxed text-neutral-600">
              {{ 'footer.newsletter_description' | t }}
            </p>
          {% endif %}
          {% if section.settings.show_social %}
            <ul class="mt-10 flex flex-wrap items-center gap-6" aria-label="{{ 'footer.social_aria' | t }}">
              <li>
                <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_facebook' | t }}">
                  <img src="{{ 'icons/facebook.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5" loading="lazy">
                </a>
              </li>
              <li>
                <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_instagram' | t }}">
                  <img src="{{ 'icons/instagram.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5" loading="lazy">
                </a>
              </li>
              <li>
                <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_x' | t }}">
                  <img src="{{ 'icons/x.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-5" loading="lazy">
                </a>
              </li>
              <li>
                <a href="#" class="text-[#333333] transition-opacity hover:opacity-70" aria-label="{{ 'footer.social_youtube' | t }}">
                  <img src="{{ 'icons/youtube.svg' | asset_url }}" width="20" height="20" alt="" class="h-5 w-6" loading="lazy">
                </a>
              </li>
            </ul>
            <p class="mt-3 mb-10 lg:mb-0 text-[10px] font-normal uppercase tracking-wide text-neutral-500">{{ 'footer.social_accounts_caption' | t }}</p>
          {% endif %}
        </div>
      {% endif %}

      {%- if footer_menu.links.size > 0 -%}
        {% for link in footer_menu.links %}
          <nav class="site-footer__col px-0 lg:px-1" aria-label="{{ link.title | escape }}">
            {% if link.links.size > 0 %}
              <details
                id="site-footer-nav-{{ section.id }}-{{ forloop.index }}"
                class="site-footer__nav-details group border-b border-[#c8c4a8] lg:border-0"
              >
                <summary
                  class="flex cursor-pointer list-none items-center justify-between gap-3 py-3 text-base lg:text-lg font-bold uppercase text-[#333333] outline-none marker:hidden [&::-webkit-details-marker]:hidden focus-visible:ring-2 focus-visible:ring-[#333333]/35 focus-visible:ring-offset-2 focus-visible:ring-offset-[#F5F5F0] lg:pointer-events-none lg:cursor-default lg:py-0 lg:focus-visible:ring-0"
                >
                  <span>{{ link.title | escape }}</span>
                  <svg
                    class="h-5 w-5 shrink-0 text-[#333333] transition-transform duration-200 group-open:rotate-180 lg:hidden"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <ul class="mt-0 space-y-3 border-t border-[#c8c4a8] pb-4 pt-4 text-base font-normal text-[#333333] lg:mt-6 lg:border-t-0 lg:pb-0 lg:pt-0">
                  {% for child_link in link.links %}
                    <li>
                      <a
                        href="{{ child_link.url }}"
                        class="transition-opacity hover:opacity-70{% if child_link.active %} font-medium{% endif %}"
                        {% if child_link.current %}aria-current="page"{% endif %}
                      >
                        {{- child_link.title | escape -}}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            {% elsif link.url != blank %}
              <h3 class="border-b border-[#333333]/18 py-3 text-lg font-bold uppercase text-[#333333] lg:border-0 lg:py-0">
                <a href="{{ link.url }}" class="transition-opacity hover:opacity-70{% if link.active %} font-medium{% endif %}">{{ link.title | escape }}</a>
              </h3>
            {% else %}
              <h3 class="border-b border-[#333333]/18 py-3 text-lg font-bold uppercase text-[#333333] lg:border-0 lg:py-0">{{ link.title | escape }}</h3>
            {% endif %}
          </nav>
        {% endfor %}
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div class="site-footer__col {% unless block.type == '@app' %}px-10{% endunless %}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="text-lg font-bold uppercase text-[#333333]">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <div class="footer-block__text rte mt-6 text-base font-normal text-neutral-700 [&_a]:underline [&_a]:underline-offset-4">
                  {{ block.settings.subtext }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    {% comment %} <div class="relative overflow-hidden text-center mt-24">
      <div class="relative z-[1] flex flex-col items-center mb-5">
        <img
          src="{{ 'icons/logo-prava.svg' | asset_url }}"
          width="200"
          height="48"
          alt="{{ shop.name | escape }}"
          class="h-auto w-[min(100%,300px)] brightness-0"
          loading="lazy"
        >
        {% liquid
          assign tag_yr = section.settings.tagline_year | strip
          if tag_yr == blank
            assign tag_yr = '1983'
          endif
        %}
        <p class="mt-5 text-base font-medium">{{ 'footer.tagline_since' | t: year: tag_yr }}</p>
      </div>
    </div> {% endcomment %}

    <div class="site-footer__legal lg:mt-4 flex flex-col gap-6 lg:border-t border-[#c8c4a8] pt-8 lg:mt-56 md:flex-row md:items-center md:justify-between md:gap-8 text-center lg:text-left">
      <p class="text-xs text-[#333333]/85 md:text-sm"><b>{{ 'footer.copyright' | t: year: footer_year, shop_name: shop.name }}</b></p>
      {%- if footer_show_language or footer_show_bottom_nav -%}
        <div class="flex flex-col items-center gap-4 md:flex-row md:flex-wrap md:items-center md:justify-center lg:justify-end md:gap-x-8 md:gap-y-3">
          {% if footer_show_language %}
            <div
              class="site-footer__language-switcher"
              aria-label="{{ 'footer.language_switcher_aria' | t }}"
            >
              {% render 'header-language-switcher' %}
            </div>
          {% endif %}
          {%- if footer_show_bottom_nav -%}
            <nav aria-label="{{ footer_bottom_menu.title | escape }}">
              <ul class="flex flex-wrap items-center justify-center lg:justify-end gap-x-6 gap-y-2 text-xs md:justify-end md:text-sm">
                {% for link in footer_bottom_menu.links %}
                  <li>
                    <a
                      href="{{ link.url }}"
                      class="text-[#333333] decoration-[#333333]/35 underline-offset-4 transition-opacity hover:opacity-70{% if link.active %} font-medium{% endif %}"
                      {% if link.current %}aria-current="page"{% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </nav>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  <script>
    (function () {
      var footer = document.querySelector('.site-footer');
      if (!footer) return;
      var nodes = footer.querySelectorAll('.site-footer__nav-details');
      if (!nodes.length) return;
      var mq = window.matchMedia('(min-width: 1024px)');
      function sync() {
        var open = mq.matches;
        nodes.forEach(function (el) {
          el.open = open;
        });
      }
      sync();
      mq.addEventListener('change', sync);
    })();
  </script>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "div",
  "class": "footer-group-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading.label",
      "info": "t:sections.footer.settings.newsletter_heading.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label"
    },
    {
      "type": "text",
      "id": "tagline_year",
      "label": "t:sections.footer.settings.tagline_year.label",
      "default": "1983"
    }
  ],
  "default": {
    "settings": {
      "newsletter_enable": true,
      "show_social": true,
      "tagline_year": "1983"
    }
  }
}
{% endschema %}
