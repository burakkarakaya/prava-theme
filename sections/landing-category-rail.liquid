<section class="prava-category-rail bg-custom-color text-neutral-900 overflow-hidden" aria-label="{{ 'sections.category_rail.aria_label' | t }}" style="--pcr-pad-x: 40px;">
  <div class="mx-auto max-w-[1680px] px-5 lg:px-[var(--pcr-pad-x)] pb-10 pt-16 lg:pb-16 lg:pt-44">
    {% if section.settings.heading != blank %}
      <h2 class="text-center text-4xl font-semibold tracking-tight text-neutral-900 lg:text-[70px]">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <div class="mx-auto mt-10 max-w-2xl text-center font-normal text-neutral-600 text-xl rte">
        {{ section.settings.description }}
      </div>
    {% endif %}
    <div class="prava-category-rail__viewport prava-swiper-widget mt-12 lg:mt-20">
      {% render 'swiper-widget-arrows' %}
      <div class="swiper prava-category-rail__swiper w-full overflow-visible">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign img_loading = 'lazy'
              if forloop.first
                assign img_loading = 'eager'
              endif
            %}
            {% render 'landing-category-rail-item',
              block: block,
              collection: block.settings.collection,
              loading: img_loading
            %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategori şeridi",
  "tag": "div",
  "class": "landing-category-rail-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Minik Gezintiler"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Açıklama",
      "default": "<p>Bebeğinizin rahatlığı ve sizin konforunuz düşünülerek tasarlanan bebek arabalarını keşfedin.</p>"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Koleksiyon",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Koleksiyon"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Özel başlık",
          "info": "Boş bırakılırsa koleksiyon adı kullanılır."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Özel görsel",
          "info": "Boş bırakılırsa koleksiyon öne çıkan görseli kullanılır."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Bağlantı metni",
          "info": "Boş bırakılırsa varsayılan çeviri kullanılır."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategori şeridi",
      "blocks": [
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" },
        { "type": "collection_card" }
      ]
    }
  ]
}
{% endschema %}
